{
  "name": "@homekeeper/server",
  "version": "0.1.0",
  "private": true,
  "description": "HomeKeeper MCP server (Streamable HTTP, MCP 2025-11-25)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "unpdf": "^1.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
